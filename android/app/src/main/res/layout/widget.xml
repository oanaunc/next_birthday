<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="UP NEXT" android:textColor="#245C49" android:textSize="10sp" android:letterSpacing="0.12" android:textStyle="bold"/>
    <ImageView android:id="@+id/widget_avatar" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginTop="6dp" android:visibility="gone" android:contentDescription=""/>
    <TextView android:id="@+id/widget_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-serif" android:textColor="#183F33" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_number" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="48sp" android:textStyle="bold" android:fontFamily="serif" android:textColor="#245C49" android:visibility="gone"/>
    <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="#596D5F"/>
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="10sp" android:textColor="#596D5F" android:visibility="gone"/>
    <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp"/>
</LinearLayout>
